#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
COMPOSE_DEV=(-f "$ROOT_DIR/docker/compose.yml" --project-directory "$ROOT_DIR")
COMPOSE_PROD=(-f "$ROOT_DIR/docker/compose.prod.yml" --project-directory "$ROOT_DIR")
SETUP_ENTRY="${SETUP_ENTRY:-./web/setup}"

if [ ! -f "$ROOT_DIR/.env" ] && [ -f "$ROOT_DIR/.env.example" ]; then
  cp "$ROOT_DIR/.env.example" "$ROOT_DIR/.env"
  echo "Created .env from .env.example"
fi

require_docker() {
  if ! command -v docker >/dev/null 2>&1; then
    echo "Docker is not installed."
    exit 1
  fi

  if ! docker info >/dev/null 2>&1; then
    echo "Docker daemon is not running. Start Docker Desktop first."
    exit 1
  fi
}

run_up() {
  require_docker
  stop_prod_if_running
  docker compose "${COMPOSE_DEV[@]}" up -d --remove-orphans db
  print_dev_url
}

run_down() {
  require_docker
  docker compose "${COMPOSE_DEV[@]}" down --remove-orphans
}

stop_prod_if_running() {
  if docker compose "${COMPOSE_PROD[@]}" ps --status running --services | grep -q .; then
    echo "Stopping production stack so local dev can use the app port..."
    docker compose "${COMPOSE_PROD[@]}" down --remove-orphans
  fi
}

run_logs() {
  require_docker
  echo "Watching database logs"
  docker compose "${COMPOSE_DEV[@]}" logs -f db
}

print_dev_url() {
  POSTGRES_PORT_VALUE="$(grep -E '^POSTGRES_PORT=' "$ROOT_DIR/.env" 2>/dev/null | tail -1 | cut -d= -f2- || true)"
  POSTGRES_PORT_VALUE="${POSTGRES_PORT_VALUE:-5433}"
  echo "Database is running at localhost:${POSTGRES_PORT_VALUE}"
  echo "Start the app with: cd web && npm run dev"
  echo "App URL: http://localhost:3000"
}

show_help() {
  cat <<EOF
Usage: ${SETUP_ENTRY} [command]

Commands:
  up         Start PostgreSQL
  down       Stop PostgreSQL
  logs       Stream database logs
  help       Show this help
EOF
}

case "${1:-help}" in
  up) run_up ;;
  down) run_down ;;
  logs) run_logs ;;
  help|-h|--help) show_help ;;
  *) show_help; exit 1 ;;
esac
