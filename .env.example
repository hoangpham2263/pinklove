COMPOSE_PROJECT_NAME=pinklove
WEB_PORT=3030
POSTGRES_PORT=5433
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# Used by Next.js on the host (not inside Docker). Inside Docker, compose sets DATABASE_URL automatically.
# DATABASE_URL=postgresql://app:change-me@localhost:5433/app

# Google OAuth (optional)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:3030/api/auth/google/callback
