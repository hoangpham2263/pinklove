COMPOSE_PROJECT_NAME=pinklove

POSTGRES_PORT=5433
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@pinklove.localhost.com
PGADMIN_DEFAULT_PASSWORD=admin

# DATABASE_URL=postgresql://app:change-me@localhost:5433/app

INTERNAL_API_SECRET=change-this-to-a-long-random-secret

# Controls which client IP headers the app trusts for auth rate-limit.
# none: do not trust client-supplied forwarding headers.
# reverse_proxy: trust x-forwarded-for/x-real-ip only after your own proxy strips client values and sets them.
# cloudflare: trust cf-connecting-ip only when traffic reaches the app through Cloudflare.
AUTH_TRUSTED_PROXY_MODE=none

# Non-production escape hatch for auth form CSRF checks. Production always enables CSRF.
AUTH_CSRF_DISABLED=false
# AUTH_CSRF_SECRET=change-this-to-a-long-random-secret

# Force runtime security headers outside production for staging/smoke tests.
SECURITY_HEADERS_FORCE=false

# Backup / restore security.
# BACKUP_CRON_ENABLED=true allows an external scheduler to POST /api/admin/config/backups/cron with x-internal-api-key.
BACKUP_CRON_ENABLED=false
BACKUP_CRON_CADENCE="daily database, uploads bundled with each package"
BACKUP_RETENTION_DAYS=14
BACKUP_RETENTION_MIN_COPIES=3
# Set this in production to store application-encrypted .tar.gz.enc backup packages.
# BACKUP_ENCRYPTION_KEY=change-this-to-a-long-random-backup-key
# If your storage provider already encrypts backups at rest, set this for admin status visibility.
BACKUP_STORAGE_ENCRYPTION_AT_REST=false
# Optional mounted directory / synced storage outside the app server disk. The admin UI never displays this path.
# BACKUP_REMOTE_DIR=/mnt/offsite-backups/pinklove
# Safe label only. Do not put credentials, bucket paths, signed URLs, or secrets here.
# BACKUP_REMOTE_LABEL="Offsite encrypted object storage"
